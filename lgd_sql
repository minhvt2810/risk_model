--gộp các sao kê
WITH A AS (
		select distinct CONVERT(VARCHAR(20),convert(date,txn_date),112)txn_date,customer,ld_id,CAST(amount_lcy AS FLOAT)sodu
		      ,cast(songay_qhan_caonhat as float) as dpd
			  ,ma_cra,case when approve_amount = 'null' then 0 else cast(approve_amount as float) end approve_amount
			  ,'CHOVAY' loai_tindung
			  ,pr+inte+pe+ps as arrear_amt
			  ,asset_class,loai_co_cau
			   from (select *
			               ,case when overdue_pr_amount is null then 0 else overdue_pr_amount end pr
			               ,case when overdue_in_amount ='null' then '0' else cast(overdue_in_amount as float) end inte
						   ,case when overdue_pe_amount is null then 0 else cast(overdue_pe_amount as float) end pe
						   ,case when overdue_ps_amount is null then 0 else  overdue_ps_amount end ps
						  from [dbo].[sktd_202509_202602]
			           )x----select * from [dbo].[sktd_202509_202602] where CONVERT(VARCHAR(20),convert(date,txn_date),112)='20251231'
			        WHERE CUSTOMER IS NOT NULL AND CUSTOMER NOT IN ('null') and khoi ='INDIV'
				--AND ma_sp not in('7' ,'12','105.02','107','107.01','107.02','107.03'
				--,'107.99','112','112.99','115.01','115.02','115.03','ICV0201','ICV0202'
				--,'ICV0902','ICV1103')
        union
		select distinct CONVERT(VARCHAR(20),convert(date,txn_date),112)txn_date
		      ,customer,ld_id
			  ,CAST(amount_lcy AS FLOAT)sodu
		      ,cast(songay_qhan_caonhat as float) as dpd
			  ,ma_cra,case when approve_amount = 'null' then 0 else cast(approve_amount as float) end approve_amount
			  ,'CHOVAY' loai_tindung
			  ,pr+inte+pe+ps as arrear_amt
			  ,asset_class,loai_co_cau
			   from (select *
			               ,case when overdue_pr_amount is null then 0 else overdue_pr_amount end pr
			               ,case when overdue_in_amount is null then 0 else cast(overdue_in_amount as float) end inte
						   ,case when overdue_pe_amount is null then 0 else cast(overdue_pe_amount as float) end pe
						   ,case when overdue_ps_amount is null then 0 else  overdue_ps_amount end ps
						  from [dbo].[data_sktd_202603_04]---select * from [dbo].[data_sktd_202603_04]
						  where 1=1
					--	  and productgr_code not in('7' ,'12','105.02','107','107.01','107.02','107.03'
					--,'107.99','112','112.99','115.01','115.02','115.03','ICV0201','ICV0202'
					--,'ICV0902','ICV1103')
			           )x
			        WHERE CUSTOMER IS NOT NULL AND CUSTOMER NOT IN ('null') and khoi ='INDIV'
		union
		select distinct CONVERT(VARCHAR(20),convert(date,mov_date),112) mov_date,customer_id2,contract_ref_no,cast(outstanding_vnd as float)sodu
		       ,case when cast(day_princ_over as float)>cast(day_inter_over as float) then cast(day_princ_over as float)
			           else cast(day_inter_over as float) end dpd
				,contract_no,cast(lcy_contract_amount as float)lcy_contract_amount
				,'CHOVAY' loai_tindung
				,cast(amount_princ_over as float)+cast(amount_inter_over as float) as arrear_amt
				,case when loan_group = 'NORM'  then '1'
				      when loan_group = 'GR2'  then '2'
					  when loan_group = 'GR3'  then '3'
					  when loan_group = 'GR4'  then '4'
					  when loan_group = 'GR5'  then '5'
					  end loan_group,co_cau_no
			   from (select t1.*
			                ,t2.PRODUCT_CODE as ma_sp
							,case when len(t1.customer_id)=4 then concat('100000',customer_id)
							     when len(t1.customer_id)=5 then concat('10000',customer_id)
								 when len(t1.customer_id)=6 then concat('1000',customer_id)
								 when len(t1.customer_id)=7 then concat('100',customer_id)
								 when len(t1.customer_id)=8 then concat('10',customer_id)
								 when len(t1.customer_id)=9 then concat('1',customer_id)
								 else t1.customer_id
								 end customer_id2 
			                from [dbo].[sktd_2020_2025] t1
							 left join (select * from (
													 select *,row_number()over(partition by EXT_REF_NO_1 order by PRODUCT_CODE asc)stt
													   from (     select EXT_REF_NO_1,PRODUCT_CODE from [dbo].[ma_sp_ld_part1]
																	where PRODUCT_CODE !='' and PRODUCT_CODE !='null'
																  union 
																  select EXT_REF_NO_1,PRODUCT_CODE from [dbo].[ma_sp_ld_part2]
																	 where PRODUCT_CODE !='' and PRODUCT_CODE !='null'
																  union 
																  select contract_ref_no,sanphamchovay from [dbo].[ma_sp_ld_part3]
																	 where sanphamchovay !='' and sanphamchovay !='null'
														  )xxx
												  )yyyy
												  where stt=1
										    ) t2
									on t1.contract_ref_no=t2.EXT_REF_NO_1
							 )xx---select * from[dbo].[sktd_2020_2025] where mucdichvay ='23NV'
			   WHERE 1=1
			   --and customer_id2 IS NOT NULL AND customer_id2 NOT IN ('null') 
			   AND customer_type ='I'
			  -- and ma_sp not in('7' ,'12','105.02','107','107.01','107.02','107.03'
					--,'107.99','112','112.99','115.01','115.02','115.03','ICV0201','ICV0202'
					--,'ICV0902','ICV1103')			   
		union
		select * from (
		select distinct CONVERT(VARCHAR(20),convert(date,txn_date),112)txn_date,cif,visa_contract,cast(current_bal as float)sodu
		           ,case when over_days ='null' then 0 else over_days end dpd
				   ,visa_contract AS hanmuc,cast(credit_limit as float)credit_limit
				   ,'CARD' loai_tindung
				   ,case when overdue_bal ='null' then 0 else cast(overdue_bal as float) end arrear_amt
				   ,loan_group,'null' co_cau_no
					from [dbo].[visa_202509_202602] --select * from [dbo].[visa_202509_202602]
					where current_bal not in ('null','0')
					AND cif IS NOT NULL AND cif NOT IN ('null')
					) x
					where sodu <0
		union
		select * from (
		select distinct CONVERT(VARCHAR(20),convert(date,txn_date),112)txn_date,cif,visa_contract,cast(current_bal as float)sodu
		           ,case when over_days ='null' then 0 else over_days end dpd
				   ,visa_contract AS hanmuc,cast(credit_limit as float)credit_limit
				   ,'CARD' loai_tindung
				   ,case when overdue_bal ='null' then 0 else cast(overdue_bal as float) end arrear_amt
				   ,loan_group,'null' co_cau_no
					from [dbo].[card_202603_04]---select * from [dbo].[card_202603_04]
					where current_bal not in ('null','0')
					AND cif IS NOT NULL AND cif NOT IN ('null')
					) x
					where sodu <0
		union
		select * from (
		select report_date,CAST(customer_id AS VARCHAR(20))customer_id,contract_number
		        ,cast(principal as float)sodu
		         ,case when balance_type ='NORM' THEN 0
				       WHEN balance_type ='GR5' THEN 361
					   WHEN balance_type ='GR4' THEN 181
					   WHEN balance_type ='GR3' THEN 91
					   WHEN balance_type ='GR2' THEN 10
					   END DPD
				   ,contract_number AS hanmuc,cast(credit_limit as float)credit_limit
				   ,'CARD' loai_tindung---select * from[dbo].[card_2020_2025] 
				   ,case when interest is null then 0 else cast(interest as float) end arrear_amt
				   ,case when balance_type ='NORM' THEN '1'
				       WHEN balance_type ='GR5' THEN '2'
					   WHEN balance_type ='GR4' THEN '3'
					   WHEN balance_type ='GR3' THEN '4'
					   WHEN balance_type ='GR2' THEN '5'
					   END loan_group
					,'null' co_cau_no
				   from [dbo].[card_2020_2025] 
				   WHERE customer_id IS NOT NULL 
				   and customer_id NOT IN ('null') and balance_type not in ('CL')
				   )x---SELECT * FROM [dbo].[card_2020_2025]
				   where sodu <0
   )
