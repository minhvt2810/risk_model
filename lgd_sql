select txn_Date as snapshot_date,customer as customer_id,ld_id,abs(sodu)total_ost,dpd
         ,ma_cra,case when approve_amount is null or approve_amount =0 or approve_amount <abs(sodu) then abs(sodu) else approve_amount end approve_amount
		 ,loai_tindung
		 ,abs(arrear_amt)arrear_amt
		 ,asset_class,loai_co_cau
     into #obs1 from (--drop table #obs1
			SELECT * FROM A
			UNION
			SELECT * FROM B
			UNION
			SELECT * FROM C
			)x
------xác định các bản ghi thỏa mãn lần đầu tiên vỡ nợ
select * from #obs1

with tag_npl as (  
  select *,ROW_NUMBER()over(partition by customer_id order by snapshot_date asc)stt
       from (
              select snapshot_date,customer_id
			  ,sum(total_ost)total_ost
		      ,max(dpd)max_dpd
			  ,max(cast(asset_class as float))max_nhomno
		       from #obs1
			   group by snapshot_date,customer_id
			   having (max(dpd)>=10 or max(cast(asset_class as float))>=2)
			   )x            
	)
select * into #obs2----drop table #obs2
    from tag_npl where stt =1

---map lấy số thu
with sothu as (
	  select CONVERT(VARCHAR(20),convert(date,paid_date),112)paid_date
			  ,case when len(customer_id)=4 then concat('100000',customer_id)
							     when len(customer_id)=5 then concat('10000',customer_id)
								 when len(customer_id)=6 then concat('1000',customer_id)
								 when len(customer_id)=7 then concat('100',customer_id)
								 when len(customer_id)=8 then concat('10',customer_id)
								 when len(customer_id)=9 then concat('1',customer_id)
								 else customer_id
								 end customer_id
			  ,sum(cast(lcy_inter_amount as float))thulai
			  ,sum(cast(lcy_princ_amount as float))thugoc
			   from [RRTD2].[dbo].[data_thuno_2019_202508]
			 group by CONVERT(VARCHAR(20),convert(date,paid_date),112),customer_id
	  union all
			select cast(ngay_tra as varchar(50))ngay_tra,ma_kh
			 ,sum(cast(thu_no_lai as float))thulai
			 ,sum(cast(thu_no_goc as float))thugoc
			from [RRTD2].[dbo].[data_thuno_202509_202512]
			group by ngay_tra,ma_kh
	  union all
			  select cast(ngay_tra as varchar(50))ngay_tra,ma_kh
			 ,sum(cast(thu_no_lai as float))thulai
			 ,sum(cast(thu_no_goc as float))thugoc
			from [RRTD2].[dbo].[data_thuno_202601_202605]
			group by ngay_tra,ma_kh
  )--select distinct substring(paid_date,1,4) from sothu
,ghep_sothu as (
    
	 select t1.*,isnull(t2.tongthu,0)tongthu,isnull(t2.paid_date,'20261231')paid_date
	     --,datediff(month,snapshot_date,paid_date) date_diff
		 from (select * from #obs2)t1
		 left join (select paid_date,customer_id,thulai+thugoc as tongthu from sothu) t2
		 on t1.customer_id=t2.customer_id
		 and t1.snapshot_date<t2.paid_date
	
	)
select *
       ,datediff(month,snapshot_date,paid_date) date_diff
           into #ghep_sothu---drop table #ghep_sothu
		   from ghep_sothu
------xác định các bản ghi vỡ nợ lại

with tag_npl as (  
  select *,ROW_NUMBER()over(partition by customer_id order by snapshot_date asc)stt
       from (
              select snapshot_date,customer_id
			  ,sum(total_ost)total_ost
		      ,max(dpd)max_dpd
			  ,max(cast(asset_class as float))max_nhomno
		       from #obs1
			   group by snapshot_date,customer_id
			   having (max(dpd)>=10 or max(cast(asset_class as float))>=2)
			   )x            
	)
,tag_secured as (  
    select *,ROW_NUMBER()over(partition by customer_id order by snapshot_date asc)stt
       from (
              select snapshot_date,customer_id
			  ,sum(total_ost)total_ost
		      ,max(dpd)max_dpd
			  ,max(cast(asset_class as float))max_nhomno
		       from #obs1
			   group by snapshot_date,customer_id
			   having (max(dpd)=0 and max(cast(asset_class as float))=1)
			   )x            
	)
,ngay_secured as (  
	select t1.*
		,t2.snapshot_date as next_secured_date
		,row_number()over(partition by t1.snapshot_date,t1.customer_id order by t2.snapshot_date asc)stt_secured
		,t2.total_ost as total_ost_secured
			 from (select * from #obs2)t1
			 left join (select * from tag_secured)t2
			 on t1.customer_id=t2.customer_id
			 and t1.snapshot_date<t2.snapshot_date
	
	)--select * from ngay_secured where stt_secured=1
,ngay_vono_next as (
 	select t1.*
		,t2.snapshot_date as next_npl_date
		,row_number()over(partition by t1.snapshot_date,t1.customer_id,t1.next_secured_date order by t2.snapshot_date asc)stt_nplnext
		,datediff(month,t1.next_secured_date,t2.snapshot_date)date_diff_secured
			 from (select * from ngay_secured where stt_secured=1)t1
			 left join (select * from tag_npl)t2
			 on t1.customer_id=t2.customer_id
			 and t1.next_secured_date<t2.snapshot_date
      )
select * into #obs_vono_lai---drop table #obs_vono_lai
   from ngay_vono_next where stt_nplnext=1

select * from #obs_vono_lai where date_diff_secured is not null
-----------tính lgd
--chốt thu trong 24 tháng
with a as (
             select *
			    ,case when date_diff_secured>24 and date_diff_secured is not null then 'secured' else 'unsecured' end tag_secured
			    from #obs_vono_lai
	 )
, b as (
     select t1.*
	  ,t2.tongthu,t2.paid_date,t2.date_diff as date_diff_thang_thu
	  ,t2.tongthu/power((1+0.08),(t2.date_diff/12))tongthu_npv
        from a t1
        left join (select * from #ghep_sothu) t2----select * from #ghep_sothu where customer_id='1000039984'
		on t1.customer_id=t2.customer_id
		and t1.snapshot_date=t2.snapshot_date
   )--select * from b
,c as (   
	select snapshot_date,customer_id,total_ost,total_ost_secured,tag_secured
	       ,round(isnull(sum(case when date_diff_thang_thu <=24 then tongthu_npv end),0),2)sothu
	   from b
	   where tag_secured ='unsecured'
	   group by snapshot_date,customer_id,total_ost,total_ost_secured,tag_secured

	union all

	select snapshot_date,customer_id,total_ost,total_ost_secured,tag_secured
	       ,round(isnull(sum(case when paid_date<next_secured_date then tongthu_npv end),0),2)sothu
	   from b
	   where tag_secured ='secured'
	   group by snapshot_date,customer_id,total_ost,total_ost_secured,tag_secured
	)--select * from c
,d as (
    select *
	   ,round(case when tag_secured ='unsecured' and total_ost<=sothu then 0
	         when tag_secured ='unsecured' and total_ost>sothu then (total_ost-sothu)/total_ost
	         when tag_secured ='secured' and total_ost<=(sothu+total_ost_secured) then 0
			 when tag_secured ='secured' and total_ost>(sothu+total_ost_secured) then (total_ost-sothu-total_ost_secured)/total_ost
			end,2)lgd
	   from c
	   where total_ost>0
      )
select *
       ,case when lgd >=0.9 then 1 else 0 end tag_gb
	     into [RRTD2].[dbo].[obs_lgd]
         from d
