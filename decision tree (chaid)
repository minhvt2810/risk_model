expected_trend <- read_excel("D:\\Data Minh\\TSCORE\\Chân dung khách hàng\\trend.xlsx")

combined <- sheet_names %>%
  purrr::set_names() %>%
  map(.f = ~import("D:\\Data Minh\\TSCORE\\Chân dung khách hàng\\var_moi1.xlsx", which = .x)) %>%
  bind_rows(.id = "Biến") %>%
  mutate(bad_rate = neg/count) %>%
  group_by(variable) %>%
  mutate(max_dis =max(count_distr)
         ,dis_missing = max(count_distr[bin=="-99"],na.rm = TRUE)
  ) %>%
  ungroup() %>%
  group_by(variable) %>% 
  mutate(trend_decre = all(diff(bad_rate) < 0)## xét actual trend
         ,trend_incre = all(diff(bad_rate) > 0)
         ,trend_decre = case_when(trend_decre == "TRUE" ~ -1, TRUE ~ 0)
         ,trend_incre = case_when(trend_incre == "TRUE" ~ 1, TRUE ~ 0)
         ,trend_actual = case_when(trend_decre == -1 ~ -1
                                   ,trend_incre == 1 ~ 1
                                   ,TRUE ~ 0
         )
  ) %>%
  left_join(expected_trend,by = c("variable"="variable")) %>%
  mutate(
    percent_bad = neg/sum(neg)
    ,percent_good = pos/sum(pos)
    ,cum_percent_bad =cumsum(percent_bad)
    ,cum_percent_good =cumsum(percent_good)
    ,gini_thanhphan = dplyr::if_else(lag(cum_percent_bad) %in% c(0, NA),cum_percent_good*0.5*cum_percent_bad
                                     ,(cum_percent_bad-lag(cum_percent_bad))*0.5*(cum_percent_good+lag(cum_percent_good))
    )
    ,gini_woe_dev = abs((0.5-sum(gini_thanhphan))/0.5)
  ) #%>% filter(total_iv >= 0.02 & dis_missing<0.3)
